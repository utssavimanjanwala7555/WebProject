@model MonthlyBudget
@{
    ViewData["Title"] = "Monthly Income";
}
<h1 class="page-title mb-1">Monthly income</h1>
<p class="text-muted mb-4">Set the income used to calculate your monthly balance.</p>
<div class="form-card">
<form asp-action="SetIncome" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row">
        <div class="col-md-4 mb-3"><label asp-for="Month" class="form-label"></label><select asp-for="Month" class="form-select">@for (var m = 1; m <= 12; m++) { <option value="@m">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option> }</select><span asp-validation-for="Month" class="text-danger"></span></div>
        <div class="col-md-4 mb-3"><label asp-for="Year" class="form-label"></label><input asp-for="Year" class="form-control" type="number" min="2000" max="2100" /><span asp-validation-for="Year" class="text-danger"></span></div>
        <div class="col-md-4 mb-3"><label asp-for="Income" class="form-label"></label><div class="input-group"><span class="input-group-text">₹</span><input asp-for="Income" class="form-control" type="number" min="0" step="0.01" /></div><span asp-validation-for="Income" class="text-danger"></span></div>
    </div>
    <div class="d-flex gap-2"><button type="submit" class="btn btn-primary">Save income</button><a asp-action="Index" class="btn btn-light">Cancel</a></div>
</form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

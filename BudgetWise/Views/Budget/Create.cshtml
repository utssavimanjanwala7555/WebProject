@model Expense
@{
    ViewData["Title"] = "Add Expense";
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
}
<h1 class="page-title mb-1">Add expense</h1>
<p class="text-muted mb-4">Record a purchase or payment.</p>
@if (!categories.Any())
{
    <div class="alert alert-warning">You need to create a category before adding an expense. <a asp-controller="Categories" asp-action="Create">Create a category</a>.</div>
}
<div class="form-card">
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" placeholder="e.g. Grocery shopping" /><span asp-validation-for="Title" class="text-danger"></span></div>
    <div class="row">
        <div class="col-md-6 mb-3"><label asp-for="Amount" class="form-label"></label><div class="input-group"><span class="input-group-text">₹</span><input asp-for="Amount" class="form-control" type="number" min="0.01" step="0.01" /></div><span asp-validation-for="Amount" class="text-danger"></span></div>
        <div class="col-md-6 mb-3"><label asp-for="Date" class="form-label"></label><input asp-for="Date" class="form-control" type="date" /><span asp-validation-for="Date" class="text-danger"></span></div>
    </div>
    <div class="mb-3"><label asp-for="CategoryId" class="form-label"></label><select asp-for="CategoryId" class="form-select"><option value="">Select a category</option>@foreach (var c in categories) { <option value="@c.CategoryId">@c.Name</option> }</select><span asp-validation-for="CategoryId" class="text-danger"></span></div>
    <div class="mb-4"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3" placeholder="Optional details"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
    <div class="d-flex gap-2"><button type="submit" class="btn btn-primary" disabled="@(!categories.Any())">Save expense</button><a asp-action="Index" class="btn btn-light">Cancel</a></div>
</form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

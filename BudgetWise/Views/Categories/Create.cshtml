@model Category
@{
    ViewData["Title"] = "Add Category";
}
<h1 class="page-title mb-1">Add category</h1><p class="text-muted mb-4">Create a category for your expenses.</p>
<div class="form-card">
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-4"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" placeholder="e.g. Food, Travel, Books" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <button class="btn btn-primary" type="submit">Save category</button> <a asp-action="Index" class="btn btn-light">Cancel</a>
</form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
